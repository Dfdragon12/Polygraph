#!/bin/sh
# Apache Maven Wrapper — Polygraph ERP

BASEDIR=$(cd "$(dirname "$0")" || exit; pwd)
WRAPPER_JAR="$BASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$BASEDIR/.mvn/wrapper/maven-wrapper.properties"

WRAPPER_URL=$(grep "^wrapperUrl=" "$WRAPPER_PROPERTIES" | sed 's/wrapperUrl=//')

if [ ! -f "$WRAPPER_JAR" ]; then
  if command -v curl > /dev/null; then
    curl -o "$WRAPPER_JAR" "$WRAPPER_URL" -f -s
  elif command -v wget > /dev/null; then
    wget -O "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "Error: curl o wget requeridos para descargar maven-wrapper.jar" >&2
    exit 1
  fi
fi

JAVA_CMD="${JAVA_HOME:+$JAVA_HOME/bin/}java"

exec "$JAVA_CMD" \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$BASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
