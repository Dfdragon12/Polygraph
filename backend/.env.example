# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_polygraph
DB_USER=erp_user
DB_PASS=erp_pass

# JWT
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-256-bits
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=correo@polygraphservice.com
MAIL_PASS=app-password-aqui

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Wompi — carrito de compras / OrdenCompra (WompiPasarelaPago). Sin estas 3 llaves,
# el checkout cae siempre al simulador interno (SimuladorPago.jsx).
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/

# Wompi — módulo de pagos directos (PagoController), no lo usa el carrito. Déjalas vacías
# si por ahora solo vas a usar el carrito.
WOMPI_PRIVATE_KEY=
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_REDIRECT_URL=http://localhost:5173/cliente/comprar-servicios/resultado
