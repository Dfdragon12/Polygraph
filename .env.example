# Módulo de Pagos (Wompi)
# No incluir valores reales en este archivo — es solo referencia de las variables requeridas.
# Los valores reales van en un .env local (nunca versionado) o en el gestor de secretos del entorno.

# Llave pública de Wompi (sandbox o producción). Se expone en el frontend, no es secreta.
WOMPI_PUBLIC_KEY=

# Llave privada de Wompi. SECRETA — nunca debe registrarse en logs ni en el repositorio.
WOMPI_PRIVATE_KEY=

# Secreto de integridad usado para firmar el checksum del Web Checkout. SECRETA.
WOMPI_INTEGRITY_SECRET=

# Secreto de eventos usado para validar la firma del webhook de Wompi. SECRETA.
WOMPI_EVENTS_SECRET=

# URL base de la API de Wompi (distinta entre sandbox y producción).
WOMPI_BASE_URL=

# URL a la que Wompi redirige al usuario tras completar el pago (Web Checkout).
WOMPI_REDIRECT_URL=
