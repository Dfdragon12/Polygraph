# No incluir valores reales en este archivo — es solo referencia de las variables. Los valores reales van en un .env local (nunca versionado) o en el gestor de secretos del
# entorno. Copia este archivo a ".env" en la raíz del repo y llena los valores antes de levantar docker-compose.yml (desarrollo) o docker-compose.prod.yml (producción).
# Lo que no dice OBLIGATORIA tiene un valor por defecto razonable y se puede dejar sin tocar. Guía completa: README.md, «Cómo publicar».

# ═══ OBLIGATORIAS en producción ═══

# --- Base de datos ---
# DB_HOST/DB_PORT no hacen falta con el servicio "postgres" del docker-compose (ya apuntan ahí) — solo si usas una base externa/administrada.
DB_NAME=erp_polygraph
DB_USER=erp_user
DB_PASS=

# --- Autenticación (JWT) ---
# SECRETA. Mínimo 256 bits (32+ caracteres) para HS256. Genera una nueva para producción — nunca reuses la de application-dev.yml.
JWT_SECRET=

# --- Dominio y direcciones públicas ---
# Dominio (sin https://) donde queda la plataforma; lo usa el proxy HTTPS (Caddy) de docker-compose.prod.yml. Ejemplo: app.polygraph.co
DOMINIO=
# Dirección completa del frontend CON https. Los enlaces de los correos (restablecer contraseña, enlace del candidato) se arman con esto: si queda en localhost, llegan rotos.
FRONTEND_URL=
# Orígenes que pueden llamar a la API desde el navegador (separados por coma, sin espacios). En producción, solo el dominio público; nunca localhost ni ngrok.
CORS_ALLOWED_ORIGINS=

# --- Correo (SMTP) — recuperación de contraseña, enlaces al candidato, avisos ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# --- Primer administrador (solo se usa si la base NO tiene ningún administrador) ---
# Sin contraseña por defecto: si no los defines, un servidor nuevo queda sin nadie con quién entrar. Al primer ingreso se obliga a cambiar la contraseña (mínimo 8 caracteres).
# Cuando ya entraste, puedes quitar ADMIN_PASSWORD del entorno.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Módulo de Pagos (Wompi) ---
# Llave pública (sandbox o producción). Se expone en el frontend, no es secreta.
WOMPI_PUBLIC_KEY=
# Llave privada. SECRETA — nunca en logs ni en el repositorio.
WOMPI_PRIVATE_KEY=
# Secreto de integridad para firmar el checksum del Web Checkout. SECRETA.
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos para validar la firma del webhook. SECRETA.
WOMPI_EVENTS_SECRET=
# URL base de la API de Wompi (distinta entre sandbox y producción).
WOMPI_BASE_URL=
# URL a la que Wompi redirige al usuario tras pagar (Web Checkout). En producción: https://TU-DOMINIO/cliente/comprar-servicios/resultado
WOMPI_REDIRECT_URL=

# ═══ OPCIONALES (valor por defecto entre paréntesis) ═══

# --- Carpetas (en Docker ya quedan dentro del volumen /app/uploads; solo se cambian en una instalación sin Docker) ---
# Documentos de clientes, fotos, plantillas Word y PDF generados. (./uploads)
UPLOADS_DIR=
# Cola de trabajos en segundo plano. (<UPLOADS_DIR>/trabajos)
TRABAJOS_DIR=
# Carpeta de trabajo de las conversiones a PDF. Vacío = la temporal del sistema (/tmp). Apuntarla a un disco con espacio si /tmp es chico.
LIBREOFFICE_TEMP_DIR=

# --- LibreOffice (convierte los Word a PDF) ---
# Ejecutable. (soffice — con la imagen Docker del backend ya está en el PATH; en Windows, la ruta completa a soffice.exe)
LIBREOFFICE_BINARIO=
# Conversiones simultáneas (2) y segundos máximos por conversión (60). Cada conversión usa ~150-300 MB fuera del heap.
LIBREOFFICE_MAX_CONCURRENTES=
LIBREOFFICE_TIMEOUT_SEGUNDOS=

# --- Servidor ---
# Memoria de la JVM. (-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError)
JAVA_OPTS=
# Swagger / OpenAPI. Déjalo en false en producción: expone toda la estructura de la API sin iniciar sesión. (false)
SWAGGER_ENABLED=false
# Solo UNA vez tras corregir una migración ya aplicada; después quitarla. (false)
FLYWAY_REPARAR=false
# Inicio de sesión con Google. Vacío = el botón no funciona. ()
GOOGLE_OAUTH_CLIENT_ID=
