# No incluir valores reales en este archivo — es solo referencia de las variables requeridas.
# Los valores reales van en un .env local (nunca versionado) o en el gestor de secretos del entorno.
# Copia este archivo a ".env" en la raíz del repo y llena los valores reales antes de levantar
# docker-compose.yml — ese archivo ya está en .gitignore, no se sube nunca.

# --- Base de datos ---
# DB_HOST/DB_PORT no hacen falta si usas el servicio "postgres" del docker-compose.yml (ya
# apuntan ahí solos) — solo cámbialos si usas una base de datos externa/administrada.
DB_NAME=erp_polygraph
DB_USER=erp_user
DB_PASS=

# --- Autenticación (JWT) ---
# SECRETA. Mínimo 256 bits (32+ caracteres) para HS256. Genera una nueva para producción —
# nunca reuses la de application-dev.yml.
JWT_SECRET=

# --- Correo (SMTP) — recuperación de contraseña, notificaciones, etc. ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# --- URLs públicas de producción ---
# Dominio real donde queda el frontend — sin esto, los enlaces en los correos (reset de
# contraseña, link del evaluado, etc.) apuntan a localhost.
FRONTEND_URL=
# Dominios que pueden llamar a la API desde el navegador (separados por coma, sin espacios).
# Si frontend y backend quedan detrás del mismo nginx (como en docker-compose.yml), esto casi
# no se usa (las llamadas del navegador son same-origin), pero déjalo correcto igual.
CORS_ALLOWED_ORIGINS=

# --- Swagger / OpenAPI ---
# Déjalo así (false) en producción salvo que de verdad necesites exponerlo — ver SecurityConfig.
SWAGGER_ENABLED=false

# --- Módulo de Pagos (Wompi) ---
# Llave pública de Wompi (sandbox o producción). Se expone en el frontend, no es secreta.
WOMPI_PUBLIC_KEY=

# Llave privada de Wompi. SECRETA — nunca debe registrarse en logs ni en el repositorio.
WOMPI_PRIVATE_KEY=

# Secreto de integridad usado para firmar el checksum del Web Checkout. SECRETA.
WOMPI_INTEGRITY_SECRET=

# Secreto de eventos usado para validar la firma del webhook de Wompi. SECRETA.
WOMPI_EVENTS_SECRET=

# URL base de la API de Wompi (distinta entre sandbox y producción).
WOMPI_BASE_URL=

# URL a la que Wompi redirige al usuario tras completar el pago (Web Checkout).
WOMPI_REDIRECT_URL=
